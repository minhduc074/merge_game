# Prisma Postgres / PostgreSQL
# Runtime prefers DATABASE_URL_POOLED. Prisma CLI migrations use direct DATABASE_URL.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL_POOLED="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Optional compatibility fallback used by some Prisma/Vercel integrations:
# PRISMA_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Local server
PORT=3000
NODE_ENV=development

# Admin panel credentials. Use strong values in production.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-at-least-32-random-characters"

# HMAC pepper for player bearer tokens. Use a random 32+ character value in production.
PLAYER_TOKEN_PEPPER="change-me-at-least-32-random-characters"

# Optional browser CORS allowlist. Android and the same-origin /admin page do not need it.
# Use a comma-separated allowlist if a separate web client is added later; leave unset otherwise.
# CORS_ORIGIN="https://example.com"

# Development only: lets debug Android builds appear on leaderboards.
# Do NOT set this in production.
# ALLOW_DEBUG_SCORES="true"
